{
  "name": "Atelier : construire un agent IA",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },

  // Installe Ollama + qwen2.5:3b et llama3.2:3b, uv et OpenCode. S'exécute une fois (et dans les prebuilds).
  "onCreateCommand": "bash .devcontainer/setup.sh",

  // Lance le serveur Ollama et la page web de l'agent à chaque démarrage du codespace.
  "postStartCommand": "bash .devcontainer/start-ollama.sh && bash .devcontainer/start-app.sh",

  // La page web de l'agent (Streamlit) s'ouvre dans un nouvel onglet du navigateur.
  "forwardPorts": [8804],
  "portsAttributes": {
    "8804": { "label": "Agent", "onAutoForward": "openBrowser" }
  },

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/.opencode/bin"
  },

  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
